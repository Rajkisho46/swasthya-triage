# ==============================================================================
# SWASTHYA TRIAGE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Runtime
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
DEBUG=True

# JWT & RBAC Security
JWT_SECRET_KEY=replace_with_secure_random_hex_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Credentials (Server-Side Only - NEVER expose to client)
GEMINI_API_KEY=
AI_MODEL_NAME=gemini-2.5-flash

# Database Configuration (SQLite default for hackathon/demo, PostgreSQL ready)
DATABASE_URL=sqlite+aiosqlite:///./swasthya_triage.db

# SMTP / Transactional Email Provider (Server-Side Only - NEVER expose to client)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@swasthyatriage.gov.in
SMTP_FROM_NAME=Swasthya Triage
SMTP_USE_TLS=True

# OTP Parameters
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
