# ==============================================================================
# SWASTHYA TRIAGE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Runtime
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
DEBUG=True

# JWT & RBAC Security (Server-Side Only)
JWT_SECRET_KEY=replace_with_secure_random_hex_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Healthcare AI Provider Abstraction (Server-Side Only - NEVER expose to frontend)
# Options: "gemini" | "openai" | "anthropic"
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash

# Provider API Keys (Only the configured provider key is required)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Speech-to-Text Provider (Server-Side Only)
# Options: "gemini" | "openai" | "groq"
STT_PROVIDER=gemini
STT_API_KEY=
STT_MODEL=gemini-2.5-flash

# Rate Limiting & File Upload Controls
AI_RATE_LIMIT=30
FILE_UPLOAD_MAX_MB=25
MAX_AUDIO_SIZE_BYTES=26214400

# Database Configuration (Async SQLite default for local dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./swasthya_triage.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/swasthya_triage

# SMTP / Transactional Email Provider (Server-Side Only - NEVER expose to client)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@swasthyatriage.gov.in
SMTP_FROM_NAME=Swasthya Triage
SMTP_USE_TLS=True

# OTP Parameters
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
