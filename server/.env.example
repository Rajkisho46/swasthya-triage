# ==============================================================================
# SWASTHYA TRIAGE - SERVER ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env or server/.env and fill in your values.
# NEVER commit .env files containing real passwords or API keys.

# Server Runtime
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
DEBUG=True

# JWT & RBAC Security
JWT_SECRET_KEY=replace_with_secure_random_hex_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Credentials (Server-Side Only - NEVER expose to client)
GEMINI_API_KEY=
AI_MODEL_NAME=gemini-2.5-flash

# Database Configuration (SQLite default for local development, PostgreSQL ready)
DATABASE_URL=sqlite+aiosqlite:///./swasthya_triage.db

# ==============================================================================
# REAL GMAIL SMTP EMAIL CONFIGURATION (Server-Side Only)
# ==============================================================================
# Instructions for Gmail SMTP:
# 1. Enable 2-Step Verification on the sender Google account (https://myaccount.google.com/security).
# 2. Generate an App Password (https://myaccount.google.com/apppasswords).
#    Select App: "Mail", Device: "Other (Custom name)" -> Name: "Swasthya Triage".
# 3. Copy the 16-character App Password and paste below as SMTP_PASSWORD.
# 4. Do NOT use your normal Google account password.
# 5. The sender Gmail can be different from patient user emails.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Swasthya Triage
SMTP_USE_TLS=True

# OTP Security Parameters
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
